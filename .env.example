# Never commit real keys or passwords. Use Render > Environment or local .env.
VT_API_KEY=
PHISHTANK_ENABLED=true
# Optional key: without it PhishTank permits fewer requests.
PHISHTANK_APP_KEY=
PHISHTANK_USER_AGENT=phishtank/PhishingHUB-student-project
URLHAUS_AUTH_KEY=
ABUSEIPDB_API_KEY=
PULSEDIVE_API_KEY=

IMAP_SERVER=imap.gmail.com
IMAP_USER=
# Use a provider-supported app password when required.
IMAP_PASS=
# Required access code for the server mailbox. Choose a long random value.
IMAP_SCAN_TOKEN=

# Optional AI English summary. The standard report works without this.
OPENROUTER_API_KEY=
AI_MODEL=openrouter/free
AI_FALLBACK_MODEL=
